# ============================================================
# HireMatch AI - contoh konfigurasi environment
# Salin file ini menjadi .env.local lalu sesuaikan nilainya.
# JANGAN commit .env.local / .env (berisi rahasia).
# ============================================================

# Database MySQL 8 (XAMPP)
DATABASE_URL="mysql://root:@localhost:3306/hirematch"

# Auth: wajib diganti dengan string acak minimal 32 karakter
# Contoh membuat: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="ganti-dengan-secret-acak-minimal-32-karakter"
# Umur sesi JWT dalam hari (opsional, default 7)
SESSION_TTL_DAYS="7"
# URL dasar aplikasi, dipakai untuk tautan verifikasi email
APP_URL="http://localhost:3000"

# AI: USE_MOCK dipakai backend, MOCK_AI dipakai pipeline AI.
# Samakan keduanya saat memilih mode mock atau AI asli.
USE_MOCK="true"
MOCK_AI=1
# API key Gemini untuk tim AI (backend tidak memakainya langsung)
GEMINI_API_KEY=
# Model default pipeline AI
GEMINI_MODEL=gemini-3.5-flash
# Nama yang dibaca src/lib/runtime.ts
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# Alias sesuai spesifikasi kontrak backend
GEMINI_EMBED_MODEL=gemini-embedding-001

# Endpoint screening AI (opsional)
# Jika diisi, POST /api/screen memerlukan Authorization: Bearer <token>.
SCREEN_API_TOKEN=
# Batas request per menit per IP/key untuk endpoint screening.
SCREEN_RATE_LIMIT_PER_MINUTE=60

# SMTP opsional. Jika SMTP_HOST kosong, tautan verifikasi hanya ditulis ke console.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="HireMatch AI <no-reply@hirematch.local>"
