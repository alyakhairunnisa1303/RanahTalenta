# Google AI Studio (Gemini) API key. Server-only — never expose with NEXT_PUBLIC_*.
GEMINI_API_KEY=

# Optional. Defaults to gemini-2.5-flash.
GEMINI_MODEL=gemini-2.5-flash

# Optional. Defaults to text-embedding-004.
GEMINI_EMBEDDING_MODEL=text-embedding-004

# Set to 1 to use the deterministic offline scorer (no API key required).
MOCK_AI=0
