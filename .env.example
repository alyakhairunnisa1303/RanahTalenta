# Google AI Studio (Gemini) API key. Server-only — never expose with NEXT_PUBLIC_*.
GEMINI_API_KEY=

# Optional. Defaults to gemini-2.5-flash.
GEMINI_MODEL=gemini-2.5-flash

# Optional. Defaults to text-embedding-004.
GEMINI_EMBEDDING_MODEL=text-embedding-004

# Set to 1 to use the deterministic offline scorer (no API key required).
MOCK_AI=0

# Optional. If set, POST /api/screen requires "Authorization: Bearer <token>".
SCREEN_API_TOKEN=

# Optional. Requests per minute per client IP/key. Defaults to 60.
SCREEN_RATE_LIMIT_PER_MINUTE=60
APPLICATION_DOCUMENTS_DIR=./data/application-documents
POSTGRES_PASSWORD=change-this-local-password
DATABASE_URL=postgresql://postgres:change-this-local-password@localhost:5432/hirematch
DATABASE_SSL=false
AUTH_SECRET=replace-with-at-least-32-random-characters
